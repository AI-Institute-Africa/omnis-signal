# Database Configuration
DATABASE_URL=postgresql://airesearch:airesearch@localhost:5432/ai_research_intelligence

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
ENVIRONMENT=development
DEBUG=true

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=ai-research@yourdomain.com
EMAIL_ENABLED=false

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Default LLM Provider
DEFAULT_LLM_PROVIDER=openai

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=ai_research

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Scheduler
DIGEST_SCHEDULE_HOURS=4
CRAWLER_SCHEDULE_MINUTES=15
DEDUPLICATION_SCHEDULE_MINUTES=30
TREND_ANALYSIS_SCHEDULE_MINUTES=60

# Alert Thresholds
HIGH_PRIORITY_SCORE_THRESHOLD=85
MEDIUM_PRIORITY_SCORE_THRESHOLD=65
